#!/bin/sh
# POSIX twin of bin/secret-audit.ps1 — delegates to the canonical PowerShell implementation
# so bash-based harnesses and adopters on macOS/Linux can call ./bin/secret-audit directly.
dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if command -v pwsh >/dev/null 2>&1; then
  exec pwsh -NoProfile -File "$dir/secret-audit.ps1" "$@"
else
  echo "secret-audit: PowerShell (pwsh) not found on PATH" >&2
  exit 127
fi
