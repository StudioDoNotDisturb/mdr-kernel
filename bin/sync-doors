#!/bin/sh
dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 1
for engine in "$dir/mdr-kernel.exe" "$dir/mdr-kernel"; do
    if [ -x "$engine" ]; then exec "$engine" sync-doors "$@"; fi
done
if command -v mdr-kernel >/dev/null 2>&1; then exec mdr-kernel sync-doors "$@"; fi
echo 'mdr-kernel: install the native binary.' >&2
exit 127
