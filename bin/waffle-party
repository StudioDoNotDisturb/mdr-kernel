#!/bin/sh
# POSIX twin of bin/waffle-party.ps1 — delegates to the canonical PowerShell implementation
# so bash-based harnesses and adopters on macOS/Linux can call ./bin/waffle-party directly.
dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if command -v pwsh >/dev/null 2>&1; then
  exec pwsh -NoProfile -File "$dir/waffle-party.ps1" "$@"
else
  echo "waffle-party: PowerShell (pwsh) not found on PATH" >&2
  exit 127
fi
