#!/bin/sh
repo=$(git rev-parse --show-toplevel) || exit 1
for engine in "$repo/bin/mdr-kernel.exe" "$repo/bin/mdr-kernel"; do
    if [ -x "$engine" ]; then exec "$engine" hook pre-push "$@"; fi
done
if command -v mdr-kernel >/dev/null 2>&1; then
    exec mdr-kernel hook pre-push "$@"
fi
echo 'mdr-kernel: install the native binary to run the Git hooks.' >&2
exit 1
