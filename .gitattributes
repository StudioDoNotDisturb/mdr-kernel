# Normalize line endings so a cross-OS clone doesn't spew CRLF warnings.
* text=auto eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
.githooks/* text eol=lf
# Thin sh launchers and Git hooks that hand off to the Rust binary; left out of GitHub's language bar.
bin/* linguist-detectable=false
.githooks/* linguist-detectable=false
